{
  "schemaVersion": 1,
  "editors": {
    "trae-cn": {
      "detect": ["~/.trae-cn"],
      "prereq": "windows-dev-mode:rules",
      "rules": { "dir": "~/.trae-cn/user_rules", "nameTemplate": "rule-{name}", "level": "file", "frontmatter": false },
      "skills": { "dir": "~/.trae-cn/skills", "nameTemplate": "{name}", "level": "dir" }
    }
  },
  "sources": {},
  "linkTargets": [
    {
      "label": "全局规则",
      "srcDir": "D:/Seed/my-rules/rules",
      "dstDir": "~/.trae-cn/user_rules",
      "dstName": "rule-{name}",
      "level": "file",
      "editor": "trae-cn",
      "env": { "srcDir": "MY_RULES_SRC", "dstDir": "TRAE_RULES_DST" }
    },
    {
      "label": "技能",
      "srcDir": "D:/Seed/retro-skills/skills",
      "dstDir": "~/.trae-cn/skills",
      "dstName": "{name}",
      "level": "dir",
      "editor": "trae-cn",
      "env": { "srcDir": "RETRO_SKILLS_DIR", "dstDir": "TRAE_SKILLS_DST" }
    }
  ]
}
